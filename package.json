{
  "name": "@persona-ai/mcp-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NitroStack Code-Mode MCP Service with QuickJS WebAssembly & Dynamic Flag-Based Integration",
  "scripts": {
    "dev": "nitrostack-cli dev --port 3006",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "build:tsc": "tsc",
    "start:node": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "node tests/test-suite.mjs",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@nitrostack/core": "^1.1.2",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.1.3-beta.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  }
}
